---
import type { BookEntry } from "../data/schema";

// tone works as it does on PublicationRow: "shell" is cream on blue, "paper"
// is ink on the cream archive block.
interface Props {
  entry: BookEntry;
  first?: boolean;
  last?: boolean;
  tone?: "shell" | "paper";
}

const { entry, first, last, tone = "shell" } = Astro.props;
const book = entry.data;
---

<div
  class="book-row"
  data-tone={tone}
  data-first={first ? "true" : undefined}
  data-last={last ? "true" : undefined}
>
  <div class="book-row__refyear">{book.ref}<br />{book.year}</div>
  <div>
    <div class="book-row__title">{book.title}</div>
    {book.subtitle && <div class="book-row__subtitle">{book.subtitle}</div>}
    <div class="book-row__byline">{book.authors}</div>
    <div class="book-row__desc"><slot /></div>
  </div>
  <div class="book-row__facts">
    {book.facts.map((line) => <>{line}<br /></>)}
    {
      book.href ? (
        <a class="book-row__action" href={book.href}>
          {book.action} →
        </a>
      ) : (
        <span class="book-row__action">{book.action}</span>
      )
    }
  </div>
</div>

<style>
  .book-row {
    border-top: 1px solid var(--rule-cream-40);
    padding: 20px 0;
    display: grid;
    grid-template-columns: 64px 1fr 190px;
    gap: 20px;
    align-items: start;
  }

  .book-row[data-first] {
    border-top: 2px solid var(--cream);
  }

  .book-row[data-last] {
    border-bottom: 2px solid var(--cream);
  }

  .book-row__refyear {
    font: 500 12px "IBM Plex Mono", monospace;
    color: var(--cream-70);
  }

  .book-row__title {
    font: 800 40px/1 Archivo, sans-serif;
    font-stretch: 62%;
    text-transform: uppercase;
    color: var(--cream);
  }

  .book-row__subtitle {
    margin-top: 6px;
    font: 400 17px/1.25 Archivo, sans-serif;
    font-stretch: 85%;
    text-transform: uppercase;
    color: var(--cream-80);
  }

  .book-row__byline {
    margin-top: 8px;
    font: 400 12px "IBM Plex Mono", monospace;
    text-transform: uppercase;
    color: var(--cream-70);
  }

  .book-row__desc {
    margin: 10px 0 0;
    max-width: 28em;
  }

  /* From the markdown body, so outside this component's scoping. */
  .book-row__desc :global(p) {
    margin: 0;
    font: 400 17px/1.5 Archivo, sans-serif;
    color: var(--cream);
  }

  .book-row__desc :global(p + p) {
    margin-top: 0.6em;
  }

  .book-row__facts {
    font: 400 13.5px/1.7 "IBM Plex Mono", monospace;
    color: var(--cream-80);
  }

  .book-row__action {
    display: inline-block;
    border-bottom: 1px solid var(--cream);
  }

  a.book-row__action:hover {
    color: var(--cream);
    border-bottom-width: 2px;
  }

  /* Ink on the cream block — see PublicationRow for the same pair. */
  .book-row[data-tone="paper"] {
    border-top-color: var(--rule-ink);
  }

  .book-row[data-tone="paper"][data-first] {
    border-top: 2px solid var(--ink);
  }

  .book-row[data-tone="paper"][data-last] {
    border-bottom: 2px solid var(--ink);
  }

  .book-row[data-tone="paper"] .book-row__refyear,
  .book-row[data-tone="paper"] .book-row__byline {
    color: var(--ground-accent);
  }

  .book-row[data-tone="paper"] .book-row__title {
    color: var(--ink);
  }

  .book-row[data-tone="paper"] .book-row__subtitle,
  .book-row[data-tone="paper"] .book-row__facts {
    color: var(--ink-60);
  }

  .book-row[data-tone="paper"] .book-row__desc :global(p) {
    color: var(--ink);
  }

  .book-row[data-tone="paper"] .book-row__action {
    border-bottom-color: var(--ground-accent);
    color: var(--ground-accent);
  }

  .book-row[data-tone="paper"] a.book-row__action:hover {
    color: var(--ground-accent);
  }

  @media (max-width: 700px) {
    .book-row {
      grid-template-columns: 1fr;
      row-gap: 12px;
    }

    .book-row__title {
      font-size: 30px;
    }
  }
</style>
