---
// rightHref makes the right-hand mark a link — it carries the licence, and a
// licence mark that cannot be clicked through to its terms is no use.
interface Props {
  left: string;
  right: string;
  rightHref?: string;
}

const { left, right, rightHref } = Astro.props;
---

<div class="shell-footer">
  <span>{left}</span><span class="shell-footer__right">
    {rightHref ? <a href={rightHref}>{right}</a> : right}
  </span>
</div>

<style>
  .shell-footer {
    padding: 6px var(--page-pad) 26px;
    display: flex;
    justify-content: space-between;
    gap: 30px;
    font: 500 12px/1.7 "IBM Plex Mono", monospace;
    color: var(--cream-70);
    background: var(--ground-accent);
  }

  .shell-footer__right {
    white-space: nowrap;
  }

  .shell-footer__right a:hover {
    color: var(--cream);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 700px) {
    .shell-footer {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
