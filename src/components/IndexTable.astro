---
---

<div class="index-table">
  <div class="index-table__head">
    <div>REF</div>
    <div>SEQUENCE</div>
    <div>PLACE</div>
    <div>EMPLOYER</div>
  </div>
  <slot />
</div>

<style>
  .index-table {
    background: var(--cream);
    padding: 26px var(--page-pad) 30px;
  }

  .index-table__head {
    display: grid;
    /* Must stay identical to .index-row in IndexTableRow, or the column
       header stops lining up with the rows under it. The employer column is
       190px so "Deliveroo, Uber, Just Eat" fits on one line. */
    grid-template-columns: 60px 1fr 130px 190px;
    gap: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ink);
    font: 500 11px "IBM Plex Mono", monospace;
    color: var(--ink-60);
  }

  @media (max-width: 700px) {
    .index-table {
      padding: 20px 20px 24px;
    }

    .index-table__head {
      display: none;
    }
  }
</style>
