---
import { Image } from "astro:assets";
import type { FullBleedPlate } from "../data/schema";
import { paragraphs } from "../data/passage";

interface Props {
  plate: FullBleedPlate;
  marginTop?: string;
}

const { plate, marginTop = "30px" } = Astro.props;

// A sequence shot in one place states location and date on the first plate
// only, so any of these may be absent.
const metaLines = [plate.location, plate.date, plate.time].filter(Boolean);
const passage = paragraphs(plate.passage);
---

<div class="plate-full" style={`margin-top:${marginTop};--plate-h:${plate.height}`}>
  <Image
    src={plate.image}
    alt={plate.alt}
    inferSize
    class="plate-full__img"
    style={plate.objectPosition ? `object-position:${plate.objectPosition}` : undefined}
  />
  <div class="plate-full__caption">
    <div class="plate-full__ref">{plate.ref}</div>
    <div class="plate-full__body">
      <div class="plate-full__meta">
        {metaLines.map((line, i) => (
          <>
            {i > 0 ? <br /> : null}
            {line}
          </>
        ))}
      </div>
      {plate.caption ? <div class="plate-full__context">{plate.caption}</div> : null}
    </div>
  </div>
  {
    passage.length > 0 ? (
      <div class="plate-full__passage-row">
        <div />
        <div>
          {passage.map((para) => (
            <p class="plate-full__passage">{para}</p>
          ))}
        </div>
      </div>
    ) : null
  }
</div>

<style>
  /* The stated height is the height at a 1400px window, not a fixed height:
     past that the frame grows taller in proportion so the crop stays as
     framed instead of flattening into a slice. Below 1400px the min-height
     holds the stated height, which is the old behaviour. */
  .plate-full__img {
    display: block;
    width: 100%;
    /* height: auto overrides the width/height attributes Astro puts on the
       <img>; without it the attribute height wins and aspect-ratio is ignored. */
    height: auto;
    aspect-ratio: 1400 / var(--plate-h);
    min-height: calc(var(--plate-h) * 1px);
    max-height: 90vh;
    object-fit: cover;
  }

  /* The image runs edge to edge, but the caption and passage under it line up
     with the rest of the page rather than starting at the viewport edge. */
  .plate-full__caption {
    display: grid;
    grid-template-columns: var(--label-col) 1fr;
    padding: 12px 40px 0 0;
    max-width: var(--page-max);
    margin-inline: auto;
  }

  .plate-full__ref {
    padding-left: 20px;
    font: 500 11px "IBM Plex Mono", monospace;
    color: var(--ground-accent);
  }

  .plate-full__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
  }

  .plate-full__meta {
    font: 400 12.5px/1.7 "IBM Plex Mono", monospace;
    color: var(--ink-60);
  }

  .plate-full__context {
    font: 400 15px/1.55 Archivo, sans-serif;
    color: var(--ink);
  }

  /* Aligns the passage with the caption body rather than the label column. */
  .plate-full__passage-row {
    display: grid;
    grid-template-columns: var(--label-col) 1fr;
    padding: 0 40px 0 0;
    max-width: var(--page-max);
    margin-inline: auto;
  }

  .plate-full__passage {
    margin: 16px 0 0;
    max-width: 34em;
    font: 400 21px/1.55 "Source Serif 4", serif;
    color: var(--ink);
    text-wrap: pretty;
  }

  @media (max-width: 700px) {
    .plate-full__caption {
      grid-template-columns: 1fr;
      padding: 10px 20px 0;
      row-gap: 8px;
    }

    .plate-full__passage-row {
      grid-template-columns: 1fr;
      padding: 0 20px;
    }

    .plate-full__passage {
      font-size: 18px;
    }

    .plate-full__ref {
      padding-left: 0;
    }

    .plate-full__body {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
