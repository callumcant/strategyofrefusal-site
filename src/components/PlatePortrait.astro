---
import { Image } from "astro:assets";
import type { PortraitPlate } from "../data/schema";
import { paragraphs } from "../data/passage";

interface Props {
  plate: PortraitPlate;
}

const { plate } = Astro.props;

const metaLines = [plate.location, plate.date, plate.time].filter(Boolean);
const passage = paragraphs(plate.passage);
---

<div class="plate-portrait">
  <div class="plate-portrait__ref">{plate.ref}</div>
  <div class="plate-portrait__content" data-align={plate.align}>
    <Image
      src={plate.image}
      alt={plate.alt}
      inferSize
      class="plate-portrait__img"
      style={plate.objectPosition ? `object-position:${plate.objectPosition}` : undefined}
    />
    <div class="plate-portrait__body">
      <div class="plate-portrait__meta">
        {metaLines.map((line, i) => (
          <>
            {i > 0 ? <br /> : null}
            {line}
          </>
        ))}
      </div>
      {plate.caption ? <div class="plate-portrait__context">{plate.caption}</div> : null}
    </div>
    {
      passage.length > 0 ? (
        <div class="plate-portrait__passage-col">
          {passage.map((para) => (
            <p class="plate-portrait__passage">{para}</p>
          ))}
        </div>
      ) : null
    }
  </div>
</div>

<style>
  .plate-portrait {
    display: grid;
    grid-template-columns: var(--label-col) 1fr;
    margin-top: 38px;
  }

  .plate-portrait__ref {
    padding-left: 20px;
    font: 500 11px "IBM Plex Mono", monospace;
    color: var(--ground-accent);
  }

  /* A portrait frame is narrow, so the text sits beside it rather than
     underneath, where it would leave the right half of the page empty.
     Three columns: the frame, the meta and caption, then the passage. The
     passage gets its own column so it never runs under the meta block. */
  .plate-portrait__content {
    padding: 0 40px 0 0;
    display: grid;
    grid-template-columns: 340px auto minmax(0, 1fr);
    gap: 30px;
    align-items: start;
  }

  /* All three sit on one row. The row has to be stated: with the frame placed
     explicitly in column 3 on a right-aligned plate, grid's auto-placement
     only moves forward, and would drop the meta and passage onto rows below. */
  .plate-portrait__img,
  .plate-portrait__body,
  .plate-portrait__passage-col {
    grid-row: 1;
  }

  .plate-portrait__img {
    grid-column: 1;
  }

  .plate-portrait__body {
    grid-column: 2;
  }

  .plate-portrait__passage-col {
    grid-column: 3;
  }

  /* Mirrored: the image moves to the right and the text runs out to its left,
     so a pair of portraits can be set facing each other. */
  .plate-portrait__content[data-align="right"] {
    grid-template-columns: minmax(0, 1fr) auto 340px;
  }

  .plate-portrait__content[data-align="right"] .plate-portrait__img {
    grid-column: 3;
  }

  .plate-portrait__content[data-align="right"] .plate-portrait__body {
    grid-column: 2;
    text-align: right;
  }

  .plate-portrait__content[data-align="right"] .plate-portrait__passage-col {
    grid-column: 1;
  }

  .plate-portrait__content[data-align="right"] .plate-portrait__context {
    margin-left: auto;
  }

  .plate-portrait__img {
    display: block;
    width: 100%;
    height: 460px;
    object-fit: cover;
  }

  .plate-portrait__meta {
    font: 400 12.5px/1.7 "IBM Plex Mono", monospace;
    color: var(--ink-60);
  }

  /* Capped tighter than the other shapes so a long caption cannot widen the
     meta column and squeeze the passage beside it. */
  .plate-portrait__context {
    margin-top: 10px;
    max-width: 20em;
    font: 400 15px/1.55 Archivo, sans-serif;
    color: var(--ink);
  }

  /* Prose stays ragged-right whichever side the frame is on; when the text
     runs to the left of the frame it is the block that moves, not the lines. */
  .plate-portrait__content[data-align="right"] .plate-portrait__passage {
    text-align: left;
    margin-left: auto;
  }

  .plate-portrait__passage {
    margin: 0;
    max-width: 34em;
    font: 400 21px/1.55 "Source Serif 4", serif;
    color: var(--ink);
    text-wrap: pretty;
  }

  .plate-portrait__passage + .plate-portrait__passage {
    margin-top: 0.7em;
  }

  @media (max-width: 700px) {
    .plate-portrait {
      grid-template-columns: 1fr;
      margin-top: 30px;
    }

    .plate-portrait__ref {
      padding: 0 20px 8px;
    }

    /* Both alignments collapse to one column, frame then meta then passage. */
    .plate-portrait__content,
    .plate-portrait__content[data-align="right"] {
      padding: 0 20px;
      grid-template-columns: 1fr;
      row-gap: 14px;
    }

    .plate-portrait__img,
    .plate-portrait__body,
    .plate-portrait__passage-col,
    .plate-portrait__content[data-align="right"] .plate-portrait__img,
    .plate-portrait__content[data-align="right"] .plate-portrait__body,
    .plate-portrait__content[data-align="right"] .plate-portrait__passage-col {
      grid-column: 1;
      grid-row: auto;
    }

    .plate-portrait__content[data-align="right"] .plate-portrait__body {
      text-align: left;
    }

    .plate-portrait__content[data-align="right"] .plate-portrait__context,
    .plate-portrait__content[data-align="right"] .plate-portrait__passage {
      margin-left: 0;
    }

    .plate-portrait__img {
      height: 420px;
    }

    .plate-portrait__passage {
      font-size: 18px;
    }
  }
</style>
