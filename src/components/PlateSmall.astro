---
import { Image } from "astro:assets";
import type { SmallPlate } from "../data/schema";
import { paragraphs } from "../data/passage";

interface Props {
  plate: SmallPlate;
}

const { plate } = Astro.props;

const metaLines = [plate.location, plate.date, plate.time].filter(Boolean);
const passage = paragraphs(plate.passage);
---

<div class="plate-small">
  <div class="plate-small__ref">{plate.ref}</div>
  <div class="plate-small__content">
    <Image
      src={plate.image}
      alt={plate.alt}
      inferSize
      class="plate-small__img"
      style={plate.objectPosition ? `object-position:${plate.objectPosition}` : undefined}
    />
    <div class="plate-small__body">
      <div class="plate-small__meta">
        {metaLines.map((line, i) => (
          <>
            {i > 0 ? <br /> : null}
            {line}
          </>
        ))}
      </div>
      {plate.caption ? <div class="plate-small__context">{plate.caption}</div> : null}
    </div>
    {passage.map((para) => (
      <p class="plate-small__passage">{para}</p>
    ))}
  </div>
</div>

<style>
  .plate-small {
    display: grid;
    grid-template-columns: var(--label-col) 1fr;
    margin-top: 38px;
  }

  .plate-small__ref {
    padding-left: 20px;
    font: 500 11px "IBM Plex Mono", monospace;
    color: var(--ground-accent);
  }

  /* The caption sits beside the image rather than under it, so an inset frame
     does not leave the right half of the page empty. A passage, being longer,
     runs below across the whole width. */
  .plate-small__content {
    padding: 0 40px 0 0;
    display: grid;
    grid-template-columns: 520px 1fr;
    column-gap: 30px;
    /* Matches the 16px a full plate leaves above its passage. */
    row-gap: 16px;
    align-items: start;
  }

  .plate-small__img {
    display: block;
    width: 100%;
    height: 330px;
    object-fit: cover;
  }

  .plate-small__meta {
    font: 400 12.5px/1.7 "IBM Plex Mono", monospace;
    color: var(--ink-60);
  }

  .plate-small__context {
    margin-top: 10px;
    max-width: 26em;
    font: 400 15px/1.55 Archivo, sans-serif;
    color: var(--ink);
  }

  .plate-small__passage {
    grid-column: 1 / -1;
    margin: 0;
    max-width: 34em;
    font: 400 21px/1.55 "Source Serif 4", serif;
    color: var(--ink);
    text-wrap: pretty;
  }

  @media (max-width: 700px) {
    .plate-small {
      grid-template-columns: 1fr;
    }

    .plate-small__ref {
      padding: 0 20px 8px;
    }

    .plate-small__content {
      padding: 0 20px;
      grid-template-columns: 1fr;
      row-gap: 12px;
    }

    .plate-small__img {
      height: 260px;
    }

    .plate-small__passage {
      font-size: 18px;
    }
  }
</style>
