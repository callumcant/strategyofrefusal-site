---
// href is optional: a collection with record pages of its own (audio) links its
// titles, a collection without them (books, journal) renders the row as text.
interface Props {
  ref: string;
  title: string;
  description: string;
  factsLine: string;
  year: string;
  href?: string;
  last?: boolean;
}

const { ref, title, description, factsLine, year, href, last } = Astro.props;
---

<div class="pub-row" data-last={last ? "true" : undefined}>
  <div class="pub-row__ref">{ref}</div>
  <div>
    <div class="pub-row__title">{href ? <a href={href}>{title}</a> : title}</div>
    <div class="pub-row__desc">{description}</div>
  </div>
  <div class="pub-row__facts">{factsLine}</div>
  <div class="pub-row__year">{year}</div>
</div>

<style>
  .pub-row {
    display: grid;
    grid-template-columns: 52px 1fr 200px 76px;
    gap: 16px;
    align-items: start;
    padding: 15px 0;
    border-bottom: 1px solid var(--rule-cream-40);
  }

  .pub-row[data-last] {
    border-bottom: 2px solid var(--cream);
  }

  .pub-row__ref {
    font: 500 12px "IBM Plex Mono", monospace;
    color: var(--cream-70);
  }

  .pub-row__title {
    font: 700 24px/1.06 Archivo, sans-serif;
    font-stretch: 70%;
    text-transform: uppercase;
    color: var(--cream);
  }

  .pub-row__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .pub-row__desc {
    margin-top: 4px;
    font: 400 14px/1.45 Archivo, sans-serif;
    color: var(--cream-80);
  }

  .pub-row__facts {
    font: 400 13px/1.45 Archivo, sans-serif;
    color: var(--cream-80);
  }

  .pub-row__year {
    font: 500 12px "IBM Plex Mono", monospace;
    color: var(--cream-80);
    text-align: right;
  }

  @media (max-width: 700px) {
    .pub-row {
      grid-template-columns: 1fr auto;
      grid-template-areas: "title title" "ref year" "facts facts";
      row-gap: 4px;
    }

    .pub-row__ref {
      grid-area: ref;
    }

    .pub-row > div:nth-child(2) {
      grid-area: title;
    }

    .pub-row__facts {
      grid-area: facts;
    }

    .pub-row__year {
      grid-area: year;
    }
  }
</style>
