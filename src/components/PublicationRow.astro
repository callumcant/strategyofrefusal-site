---
// href is optional: a collection with record pages of its own (audio) links its
// titles, a collection without them (books, journal) renders the row as text.
//
// tone says which ground the row is sitting on. "shell" is cream on blue, for
// the home page; "paper" is ink on the cream block the index pages use. The
// two are the same row in different colours — nothing else changes.
interface Props {
  ref: string;
  title: string;
  description: string;
  factsLine: string;
  year: string;
  href?: string;
  last?: boolean;
  tone?: "shell" | "paper";
}

const { ref, title, description, factsLine, year, href, last, tone = "shell" } = Astro.props;
---

<div class="pub-row" data-tone={tone} data-last={last ? "true" : undefined}>
  <div class="pub-row__ref">{ref}</div>
  <div>
    <div class="pub-row__title">{href ? <a href={href}>{title}</a> : title}</div>
    <div class="pub-row__desc">{description}</div>
  </div>
  <div class="pub-row__facts">{factsLine}</div>
  <div class="pub-row__year">{year}</div>
</div>

<style>
  .pub-row {
    display: grid;
    grid-template-columns: 52px 1fr 200px 76px;
    gap: 16px;
    align-items: start;
    padding: 15px 0;
    border-bottom: 1px solid var(--rule-cream-40);
  }

  .pub-row[data-last] {
    border-bottom: 2px solid var(--cream);
  }

  .pub-row__ref {
    font: 500 12px "IBM Plex Mono", monospace;
    color: var(--cream-70);
  }

  .pub-row__title {
    font: 700 24px/1.06 Archivo, sans-serif;
    /* Not font-stretch — see ShellSectionHead. */
    font-variation-settings: "wdth" 70;
    text-transform: uppercase;
    color: var(--cream);
  }

  .pub-row__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .pub-row__desc {
    margin-top: 4px;
    font: 400 14px/1.45 Archivo, sans-serif;
    color: var(--cream-80);
  }

  .pub-row__facts {
    font: 400 13px/1.45 Archivo, sans-serif;
    color: var(--cream-80);
  }

  .pub-row__year {
    font: 500 12px "IBM Plex Mono", monospace;
    color: var(--cream-80);
    text-align: right;
  }

  /* Ink on the cream block. Same row, same grid — only the colours differ,
     and the ref turns blue, which is how the sequence index marks a link. */
  .pub-row[data-tone="paper"] {
    border-bottom-color: var(--rule-ink);
  }

  .pub-row[data-tone="paper"][data-last] {
    border-bottom: none;
  }

  .pub-row[data-tone="paper"] .pub-row__ref {
    color: var(--ground-accent);
  }

  .pub-row[data-tone="paper"] .pub-row__title {
    color: var(--ink);
  }

  .pub-row[data-tone="paper"] .pub-row__title a:hover {
    color: var(--ground-accent);
  }

  .pub-row[data-tone="paper"] .pub-row__desc,
  .pub-row[data-tone="paper"] .pub-row__facts,
  .pub-row[data-tone="paper"] .pub-row__year {
    color: var(--ink-60);
  }

  @media (max-width: 700px) {
    .pub-row {
      grid-template-columns: 1fr auto;
      grid-template-areas: "title title" "ref year" "facts facts";
      row-gap: 4px;
    }

    .pub-row__ref {
      grid-area: ref;
    }

    .pub-row > div:nth-child(2) {
      grid-area: title;
    }

    .pub-row__facts {
      grid-area: facts;
    }

    .pub-row__year {
      grid-area: year;
    }
  }
</style>
