---
import FieldRow from "./FieldRow.astro";
import type { SeriesRecordFields } from "../data/schema";

interface Props {
  record: SeriesRecordFields;
  note: string;
}

const { record, note } = Astro.props;
---

<div class="record-block">
  <div class="record-block__label">RECORD</div>
  <div class="record-block__content">
    <div class="record-block__fields">
      <FieldRow label="PLACE">{record.place}</FieldRow>
      <FieldRow label="DATES">{record.dates}</FieldRow>
      <FieldRow label="EMPLOYER">{record.employer}</FieldRow>
      <FieldRow label="UNION">{record.union}</FieldRow>
      <FieldRow label="DISPUTE">{record.dispute}</FieldRow>
      <FieldRow label="FRAMES">{record.framesNote}</FieldRow>
    </div>
    <p class="record-block__note">{note}</p>
  </div>
</div>

<style>
  .record-block {
    display: grid;
    grid-template-columns: var(--label-col) 1fr;
    border-bottom: 1px solid var(--rule-ink);
  }

  .record-block__label {
    padding: 22px 0 26px 20px;
    font: 500 11px/1.6 "IBM Plex Mono", monospace;
    color: var(--ground-accent);
  }

  .record-block__content {
    padding: 22px 40px 26px 0;
  }

  .record-block__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 40px;
  }

  .record-block__note {
    margin: 18px 0 0;
    max-width: 34em;
    font: 400 16px/1.6 Archivo, sans-serif;
    color: var(--ink-60);
  }

  @media (max-width: 700px) {
    .record-block {
      grid-template-columns: 1fr;
    }

    .record-block__label {
      padding: 20px 20px 8px;
    }

    .record-block__content {
      padding: 0 20px 24px;
    }

    .record-block__fields {
      grid-template-columns: 1fr;
    }
  }
</style>
