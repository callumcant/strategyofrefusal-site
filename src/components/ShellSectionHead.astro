---
// href is optional because not every section has an index page yet: Index has
// neither a page nor a collection, so a section without one renders its count
// as plain text and the arrow does not pretend to be a link. Same bargain
// TopBar makes with its dead nav items.
interface Props {
  title: string;
  countLabel: string;
  href?: string;
}

const { title, countLabel, href } = Astro.props;
---

<div class="section-head">
  <div class="section-head__title">{title}</div>
  <div class="section-head__count">{href ? <a href={href}>{countLabel}</a> : countLabel}</div>
</div>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 2px solid var(--cream);
    padding-bottom: 8px;
  }

  .section-head__title {
    font: 800 30px/1 Archivo, sans-serif;
    font-stretch: 62%;
    text-transform: uppercase;
    color: var(--cream);
  }

  .section-head__count {
    font: 500 12px "IBM Plex Mono", monospace;
    color: var(--cream);
    white-space: nowrap;
  }

  .section-head__count a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 700px) {
    .section-head__title {
      font-size: 22px;
    }
  }
</style>
