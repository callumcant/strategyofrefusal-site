---
interface NavItem {
  key: string;
  label: string;
  href?: string;
}

interface Props {
  variant: "shell" | "quiet";
  label: string;
  labelHref?: string;
  active?: string;
}

const { variant, label, labelHref, active } = Astro.props;

const shellNav: NavItem[] = [
  { key: "series", label: "Series", href: "/series" },
  { key: "books", label: "Books", href: "/books" },
  { key: "journal", label: "Journal" },
  { key: "writing", label: "Writing" },
  { key: "audio", label: "Audio", href: "/audio" },
  { key: "index", label: "Index" },
];

const quietNav: NavItem[] = [
  { key: "series", label: "Series", href: "/series" },
  { key: "books", label: "Books", href: "/books" },
  { key: "journal", label: "Journal" },
  { key: "audio", label: "Audio", href: "/audio" },
  { key: "index", label: "Index" },
];

const nav = variant === "shell" ? shellNav : quietNav;
---

<div class:list={["topbar", `topbar--${variant}`]}>
  {
    labelHref ? (
      <a href={labelHref} class="topbar__label">
        {label}
      </a>
    ) : (
      <div class="topbar__label">{label}</div>
    )
  }
  <nav class="topbar__nav">
    {
      nav.map((item) =>
        item.href ? (
          <a href={item.href} data-active={item.key === active ? "true" : undefined}>
            {item.label}
          </a>
        ) : (
          <span data-active={item.key === active ? "true" : undefined}>{item.label}</span>
        ),
      )
    }
  </nav>
</div>

<style>
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px var(--page-pad);
  }

  .topbar__label {
    font: 500 12.5px "IBM Plex Mono", monospace;
  }

  .topbar__nav {
    display: flex;
    gap: 20px;
    white-space: nowrap;
  }

  .topbar--shell {
    border-bottom: 2px solid var(--cream);
  }

  .topbar--shell .topbar__label {
    color: var(--cream);
  }

  .topbar--shell .topbar__nav {
    font: 600 13px Archivo, sans-serif;
  }

  .topbar--shell .topbar__nav a,
  .topbar--shell .topbar__nav span {
    color: var(--cream);
    padding-bottom: 2px;
  }

  .topbar--shell .topbar__nav [data-active] {
    border-bottom: 2px solid var(--cream);
  }

  .topbar--quiet {
    padding: 14px var(--page-pad);
    border-bottom: 1px solid var(--rule-ink-strong);
  }

  .topbar--quiet .topbar__label {
    color: var(--ground-accent);
  }

  .topbar--quiet .topbar__nav {
    font: 400 13px Archivo, sans-serif;
  }

  .topbar--quiet .topbar__nav a,
  .topbar--quiet .topbar__nav span {
    color: var(--ink-60);
  }

  .topbar--quiet .topbar__nav [data-active] {
    color: var(--ink);
  }

  @media (max-width: 700px) {
    .topbar {
      flex-wrap: wrap;
      gap: 10px 16px;
    }

    .topbar__nav {
      flex-wrap: wrap;
      gap: 12px 16px;
    }
  }
</style>
