---
// href is the article on the publisher's own site — writing has no record
// pages here, so the row links straight out.
interface Props {
  ref: string;
  title: string;
  publication: string;
  year: string;
  href: string;
  last?: boolean;
}

const { ref, title, publication, year, href, last } = Astro.props;
---

<a href={href} class="writing-row" data-last={last ? "true" : undefined}>
  <div class="writing-row__ref">{ref}</div>
  <div class="writing-row__title">{title}</div>
  <div class="writing-row__publication">{publication}</div>
  <div class="writing-row__year">{year}</div>
</a>

<style>
  .writing-row {
    display: grid;
    grid-template-columns: 52px 1fr 200px 76px;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule-cream-40);
  }

  .writing-row[data-last] {
    border-bottom: 2px solid var(--cream);
  }

  .writing-row__ref {
    font: 500 12px "IBM Plex Mono", monospace;
    color: var(--cream-70);
  }

  .writing-row__title {
    font: 400 17px/1.35 Archivo, sans-serif;
    color: var(--cream);
  }

  .writing-row:hover .writing-row__title {
    text-decoration: 1px underline var(--cream);
    text-underline-offset: 3px;
  }

  .writing-row__publication {
    font: 400 13px Archivo, sans-serif;
    color: var(--cream-80);
  }

  .writing-row__year {
    font: 500 12px "IBM Plex Mono", monospace;
    color: var(--cream-80);
    text-align: right;
  }

  @media (max-width: 700px) {
    .writing-row {
      grid-template-columns: 1fr auto;
      grid-template-areas: "title title" "ref year" "publication publication";
      row-gap: 4px;
    }

    .writing-row__ref {
      grid-area: ref;
    }

    .writing-row__title {
      grid-area: title;
    }

    .writing-row__publication {
      grid-area: publication;
    }

    .writing-row__year {
      grid-area: year;
    }
  }
</style>
