---
import "../styles/tokens.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  // Schema.org structured data for the page — one object, or several where a
  // page describes more than one thing (an ItemList of Books, say). Each
  // caller builds its own, typed to what that page actually is.
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, jsonLd } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// og:image needs an absolute URL to a plain file, not the ImageMetadata
// object Astro's schema gives us — getImage() renders it to one file at a
// fixed width, same as <Image> does for the page itself.
const ogImage = image
  ? new URL((await getImage({ src: image, width: 1200 })).src, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:site_name" content="Strategy of Refusal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=Source+Serif+4:opsz,wght@8..60,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
