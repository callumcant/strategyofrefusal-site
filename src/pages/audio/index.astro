---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShellFrame from "../../components/ShellFrame.astro";
import TopBar from "../../components/TopBar.astro";
import DisplayHeading from "../../components/DisplayHeading.astro";
import PublicationRow from "../../components/PublicationRow.astro";
import ArchiveBlock from "../../components/ArchiveBlock.astro";
import PhotoRecord from "../../components/PhotoRecord.astro";
import { PODCAST_NAME, PODCAST_URL, JOURNAL_NAME, JOURNAL_URL } from "../../data/archive";

const audio = (await getCollection("audio")).sort((a, b) => b.data.ref.localeCompare(a.data.ref));
const featuredFrame = (await getEntry("frames", "audio"))!.data;
---

<BaseLayout
  title="Audio — Strategy of Refusal"
  description={`Every episode of ${PODCAST_NAME}, a podcast about work, struggle and revolution by ${JOURNAL_NAME}.`}
  image={featuredFrame.image}
>
  <ShellFrame>
    <TopBar variant="shell" label="STRATEGY OF REFUSAL / AUDIO" labelHref="/" active="audio" />

    <div class="intro">
      <DisplayHeading lines={["Audio"]} size={100} lineHeight=".88" />
      <p class="intro__para">
        Every episode of <a href={PODCAST_URL}>{PODCAST_NAME}</a>, a podcast
        about work, struggle and revolution by <a href={JOURNAL_URL}>{JOURNAL_NAME}</a>
      </p>
    </div>

    <ArchiveBlock>
      {
        audio.length > 0 ? (
          audio.map((e, i) => (
            <PublicationRow
              tone="paper"
              ref={e.data.ref}
              title={e.data.title}
              description={e.data.description}
              factsLine={e.data.duration.toUpperCase()}
              year={e.data.year}
              href={`/audio/${e.id}`}
              last={i === audio.length - 1}
            />
          ))
        ) : (
          <p class="episode-list__empty">Episodes are still being catalogued and will be added shortly.</p>
        )
      }
    </ArchiveBlock>

    <PhotoRecord
      image={featuredFrame.image}
      alt={featuredFrame.alt}
      height={featuredFrame.height}
      objectPosition={featuredFrame.objectPosition}
      plateRef={featuredFrame.ref}
      location={featuredFrame.location}
      date={featuredFrame.date}
      caption={featuredFrame.caption}
    />
  </ShellFrame>
</BaseLayout>

<style>
  .intro {
    padding: 40px var(--page-pad) 30px;
  }

  .intro__para {
    margin: 24px 0 0;
    max-width: 34em;
    font: 400 19px/1.45 Archivo, sans-serif;
    color: var(--cream);
  }

  .intro__para a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }


  .episode-list__empty {
    margin: 0;
    padding: 20px 0;
    border-top: 2px solid var(--ink);
    font: 400 17px/1.5 Archivo, sans-serif;
    color: var(--ink-60);
  }
  @media (max-width: 700px) {
    .intro {
      padding: 24px 20px 20px;
    }
  }
</style>
