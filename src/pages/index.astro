---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShellFrame from "../components/ShellFrame.astro";
import TopBar from "../components/TopBar.astro";
import DisplayHeading from "../components/DisplayHeading.astro";
import ScopeLine from "../components/ScopeLine.astro";
import ShellSectionHead from "../components/ShellSectionHead.astro";
import SeriesRow from "../components/SeriesRow.astro";
import PublicationRow from "../components/PublicationRow.astro";
import WritingRow from "../components/WritingRow.astro";
import PhotoRecord from "../components/PhotoRecord.astro";
import Footer from "../components/Footer.astro";
import { getCollection, getEntry } from "astro:content";
import { writingTotal, scopeRecordTotal, scopeSince, pad } from "../data/archive";

// Series read low-to-high (S-01 first); publications read newest-first.
const byRefAsc = (a: { data: { ref: string } }, b: { data: { ref: string } }) => a.data.ref.localeCompare(b.data.ref);
const byRefDesc = (a: { data: { ref: string } }, b: { data: { ref: string } }) => b.data.ref.localeCompare(a.data.ref);

const series = (await getCollection("series")).sort(byRefAsc);
const books = (await getCollection("books")).sort(byRefDesc);
const writing = (await getCollection("writing")).sort(byRefDesc);
const homeFeaturedFrame = (await getEntry("frames", "home"))!.data;

// Audio and journal are the complete collections, so their counts are real
// rather than stated. Listing all 22 episodes or all 11 issues would swamp a
// page whose other sections run to two or three rows, so the home page shows
// the newest few and the count beside the heading carries the true size — the
// same bargain the writing section makes with a stated total. Change the
// Shown numbers to show more or fewer.
const audioShown = 4;
const audioAll = (await getCollection("audio")).sort(byRefDesc);
const audio = audioAll.slice(0, audioShown);

const journalShown = 4;
const journalAll = (await getCollection("journal")).sort(byRefDesc);
const journal = journalAll.slice(0, journalShown);

const totalFrames = series.reduce((sum, s) => sum + s.data.frames, 0);
---

<BaseLayout title="Strategy of Refusal — an archive of British labour disputes">
  <ShellFrame>
    <TopBar variant="shell" label="STRATEGYOFREFUSAL.COM" labelHref="/" />

    <div class="masthead">
      <DisplayHeading lines={["Strategy", "of refusal"]} size={96} />
      <ScopeLine
        left="AN ARCHIVE OF BRITISH LABOUR DISPUTES — PHOTOGRAPHS, BOOKS, PODCASTS, JOURNAL, WRITING"
        right={`${scopeRecordTotal} RECORDS · ${scopeSince} —`}
      />
    </div>

    <section class="section section--series">
      <ShellSectionHead
        title="Series"
        countLabel={`${pad(series.length)} RECORDS · ${totalFrames} FRAMES →`}
        href="/series"
      />
      {series.map((item, i) => <SeriesRow item={item} last={i === series.length - 1} />)}
    </section>

    <PhotoRecord
      image={homeFeaturedFrame.image}
      alt={homeFeaturedFrame.alt}
      height={homeFeaturedFrame.height}
      plateRef={homeFeaturedFrame.ref}
      location={homeFeaturedFrame.location}
      date={homeFeaturedFrame.date}
      extra={homeFeaturedFrame.extra}
      caption={homeFeaturedFrame.caption}
      captionAccentRef={homeFeaturedFrame.captionAccentRef}
    />

    <section class="section section--books">
      <ShellSectionHead title="Books" countLabel={`${pad(books.length)} RECORDS →`} href="/books" />
      {
        books.map((b, i) => (
          <PublicationRow
            ref={b.data.ref}
            title={b.data.title}
            description={b.data.summary}
            factsLine={b.data.factsLine}
            year={b.data.year}
            last={i === books.length - 1}
          />
        ))
      }
    </section>

    <section class="section section--audio">
      <ShellSectionHead title="Audio" countLabel={`${pad(audioAll.length)} EPISODES →`} href="/audio" />
      {
        audio.map((e, i) => (
          <PublicationRow
            ref={e.data.ref}
            title={e.data.title}
            description={e.data.description}
            factsLine={e.data.duration.toUpperCase()}
            year={e.data.year}
            href={`/audio/${e.id}`}
            last={i === audio.length - 1}
          />
        ))
      }
    </section>

    <section class="section section--journal">
      <ShellSectionHead title="Journal" countLabel={`${pad(journalAll.length)} ISSUES →`} href="/journal" />
      {
        journal.map((j, i) => (
          <PublicationRow
            ref={j.data.ref}
            title={j.data.title}
            description={j.data.description}
            factsLine={`${pad(j.data.contents.length)} ARTICLES`}
            year={j.data.year}
            href={`/journal/${j.id}`}
            last={i === journal.length - 1}
          />
        ))
      }
    </section>

    <section class="section section--writing">
      <ShellSectionHead title="Writing" countLabel={`${pad(writingTotal)} RECORDS →`} />
      {
        writing.map((w, i) => (
          <WritingRow
            ref={w.data.ref}
            title={w.data.title}
            form={w.data.form}
            year={w.data.year}
            last={i === writing.length - 1}
          />
        ))
      }
    </section>

    <Footer left="KEPT BY CALLUM CANT, ORGANISER · CALLUMCANT@GMAIL.COM" right="FREE TO UNIONS AND CAMPAIGNS" />
  </ShellFrame>
</BaseLayout>

<style>
  .masthead {
    padding: 30px var(--page-pad) 26px;
  }

  .section {
    padding: 8px var(--page-pad) 44px;
  }

  .section--books {
    padding: 34px var(--page-pad) 20px;
  }

  .section--audio {
    padding: 14px var(--page-pad) 20px;
  }

  .section--journal {
    padding: 14px var(--page-pad) 20px;
  }

  .section--writing {
    padding: 14px var(--page-pad) 34px;
  }

  @media (max-width: 700px) {
    .masthead {
      padding: 24px 20px 20px;
    }

    .section,
    .section--books,
    .section--audio,
    .section--journal,
    .section--writing {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
