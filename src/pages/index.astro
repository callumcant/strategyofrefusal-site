---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShellFrame from "../components/ShellFrame.astro";
import TopBar from "../components/TopBar.astro";
import DisplayHeading from "../components/DisplayHeading.astro";
import ScopeLine from "../components/ScopeLine.astro";
import ShellSectionHead from "../components/ShellSectionHead.astro";
import SeriesRow from "../components/SeriesRow.astro";
import PublicationRow from "../components/PublicationRow.astro";
import WritingRow from "../components/WritingRow.astro";
import PhotoRecord from "../components/PhotoRecord.astro";
import Footer from "../components/Footer.astro";
import { getCollection, getEntry } from "astro:content";
import { scopeRecordTotal, scopeSince, pad, LICENCE_NAME, LICENCE_URL } from "../data/archive";

// Series read low-to-high (S-01 first); publications read newest-first.
const byRefAsc = (a: { data: { ref: string } }, b: { data: { ref: string } }) => a.data.ref.localeCompare(b.data.ref);
const byRefDesc = (a: { data: { ref: string } }, b: { data: { ref: string } }) => b.data.ref.localeCompare(a.data.ref);

const homeFeaturedFrame = (await getEntry("frames", "home"))!.data;

// The home page shows the same number of every section — three — and states
// the true total beside each heading, counted from the files. Listing all 22
// episodes or all 19 articles would swamp the page, and letting each section
// run to its own length made the columns read as unequal in importance rather
// than as different sizes of collection. One number changes all six.
const homeShown = 3;

const seriesAll = (await getCollection("series")).sort(byRefAsc);
const series = seriesAll.slice(0, homeShown);

const booksAll = (await getCollection("books")).sort(byRefDesc);
const books = booksAll.slice(0, homeShown);

const audioAll = (await getCollection("audio")).sort(byRefDesc);
const audio = audioAll.slice(0, homeShown);

const journalAll = (await getCollection("journal")).sort(byRefDesc);
const journal = journalAll.slice(0, homeShown);

const writingAll = (await getCollection("writing")).sort(byRefDesc);
const writing = writingAll.slice(0, homeShown);

// Counted across every sequence, not just the three shown.
const totalFrames = seriesAll.reduce((sum, s) => sum + s.data.frames, 0);
---

<BaseLayout title="Strategy of Refusal — an archive of class struggle in Britain">
  <ShellFrame>
    <TopBar variant="shell" label="STRATEGYOFREFUSAL.COM" labelHref="/" />

    <div class="masthead">
      <DisplayHeading lines={["Strategy", "of refusal"]} size={96} />
      <ScopeLine
        left="AN ARCHIVE OF CLASS STRUGGLE IN BRITAIN"
        right={`${scopeRecordTotal} RECORDS · ${scopeSince} —`}
      />
    </div>

    <section class="section section--series">
      <ShellSectionHead
        title="Photo sequences"
        countLabel={`${pad(seriesAll.length)} SEQUENCES · ${totalFrames} FRAMES →`}
        href="/series"
      />
      {series.map((item, i) => <SeriesRow item={item} last={i === series.length - 1} />)}
    </section>

    <PhotoRecord
      image={homeFeaturedFrame.image}
      alt={homeFeaturedFrame.alt}
      height={homeFeaturedFrame.height}
      objectPosition={homeFeaturedFrame.objectPosition}
      plateRef={homeFeaturedFrame.ref}
      location={homeFeaturedFrame.location}
      date={homeFeaturedFrame.date}
      extra={homeFeaturedFrame.extra}
      caption={homeFeaturedFrame.caption}
      captionAccentRef={homeFeaturedFrame.captionAccentRef}
    />

    <section class="section section--books">
      <ShellSectionHead title="Books" countLabel={`${pad(booksAll.length)} RECORDS →`} href="/books" />
      {
        books.map((b, i) => (
          <PublicationRow
            ref={b.data.ref}
            title={b.data.title}
            description={b.data.summary}
            factsLine={b.data.factsLine}
            year={b.data.year}
            last={i === books.length - 1}
          />
        ))
      }
    </section>

    <section class="section section--journal">
      <ShellSectionHead title="Journal" countLabel={`${pad(journalAll.length)} ISSUES →`} href="/journal" />
      {
        journal.map((j, i) => (
          <PublicationRow
            ref={j.data.ref}
            title={j.data.title}
            description={j.data.description}
            factsLine={`${pad(j.data.contents.length)} ARTICLES`}
            year={j.data.year}
            href={`/journal/${j.id}`}
            last={i === journal.length - 1}
          />
        ))
      }
    </section>

    <section class="section section--writing">
      <ShellSectionHead title="Writing" countLabel={`${pad(writingAll.length)} RECORDS →`} href="/writing" />
      {
        writing.map((w, i) => (
          <WritingRow
            ref={w.data.ref}
            title={w.data.title}
            publication={w.data.publication}
            year={w.data.year}
            href={w.data.href}
            last={i === writing.length - 1}
          />
        ))
      }
    </section>

    <section class="section section--audio">
      <ShellSectionHead title="Audio" countLabel={`${pad(audioAll.length)} EPISODES →`} href="/audio" />
      {
        audio.map((e, i) => (
          <PublicationRow
            ref={e.data.ref}
            title={e.data.title}
            description={e.data.description}
            factsLine={e.data.duration.toUpperCase()}
            year={e.data.year}
            href={`/audio/${e.id}`}
            last={i === audio.length - 1}
          />
        ))
      }
    </section>

    <Footer left="KEPT BY CALLUM CANT, ORGANISER · CALLUMCANT@GMAIL.COM" right={LICENCE_NAME} rightHref={LICENCE_URL} />
  </ShellFrame>
</BaseLayout>

<style>
  .masthead {
    padding: 30px var(--page-pad) 26px;
  }

  .section {
    padding: 8px var(--page-pad) 44px;
  }

  .section--books {
    padding: 34px var(--page-pad) 20px;
  }

  .section--audio {
    padding: 14px var(--page-pad) 34px;
  }

  .section--journal {
    padding: 14px var(--page-pad) 20px;
  }

  .section--writing {
    padding: 14px var(--page-pad) 20px;
  }

  @media (max-width: 700px) {
    .masthead {
      padding: 24px 20px 20px;
    }

    .section,
    .section--books,
    .section--audio,
    .section--journal,
    .section--writing {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
