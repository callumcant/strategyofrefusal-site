---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import SeriesTitleBlock from "../../components/SeriesTitleBlock.astro";
import SeriesRecordBlock from "../../components/SeriesRecordBlock.astro";
import Plate from "../../components/Plate.astro";
import SeriesFooterNav from "../../components/SeriesFooterNav.astro";

export async function getStaticPaths() {
  const series = (await getCollection("series")).sort((a, b) => a.data.ref.localeCompare(b.data.ref));

  // The footer link is derived from position in the series order and wraps at
  // the end, so it stays correct when a series is inserted or removed.
  return series.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: series[(i + 1) % series.length] },
  }));
}

const { entry, next } = Astro.props;
const s = entry.data;

// The standfirst is the markdown body. A record that has not been written up
// yet has an empty body, and falls back to its one-line index description.
const { Content } = await render(entry);
const hasStandfirst = Boolean(entry.body?.trim());
---

<BaseLayout title={`${s.title} — Strategy of Refusal`}>
  <div class="series-page">
    <TopBar variant="quiet" label={`STRATEGY OF REFUSAL / SERIES / ${s.ref}`} labelHref="/series" active="series" />

    <SeriesTitleBlock title={s.title}>
      {hasStandfirst ? <Content /> : <p>{s.indexDescription}</p>}
    </SeriesTitleBlock>

    {
      s.detail ? (
        <>
          <SeriesRecordBlock record={s.detail.record} note={s.detail.note} />
          {s.detail.plates.map((plate, i) => (
            <Plate plate={plate} marginTop={plate.kind === "full" && i !== 0 ? "38px" : undefined} />
          ))}
        </>
      ) : (
        <SeriesRecordBlock
          record={{
            place: s.place,
            dates: s.dateLabel,
            employer: s.employer,
            union: s.union,
            dispute: s.dispute,
            framesNote: `${s.frames}`,
            related: [],
          }}
          note="Plates for this series are still being catalogued and will be added shortly."
        />
      )
    }

    <SeriesFooterNav nextRef={next.data.ref} nextTitle={next.data.title} nextHref={`/series/${next.id}`} />
  </div>
</BaseLayout>

<style>
  .series-page {
    background: var(--paper);
  }
</style>
