---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import SeriesTitleBlock from "../../components/SeriesTitleBlock.astro";
import SeriesRecordBlock from "../../components/SeriesRecordBlock.astro";
import Plate from "../../components/Plate.astro";
import SeriesFooterNav from "../../components/SeriesFooterNav.astro";
import { series, findSeries } from "../../data/series";

export function getStaticPaths() {
  return series.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;

const idx = series.findIndex((s) => s.slug === item.slug);
const nextItem = series[(idx + 1) % series.length];
---

<BaseLayout title={`${item.title} — Strategy of Refusal`}>
  <div class="series-page">
    <TopBar variant="quiet" label={`STRATEGY OF REFUSAL / SERIES / ${item.ref}`} labelHref="/series" active="series" />

    {
      item.detail ? (
        <>
          <SeriesTitleBlock title={item.title} standfirst={item.detail.standfirst} />
          <SeriesRecordBlock record={item.detail.record} note={item.detail.note} />
          {item.detail.plates.map((plate) => (
            <Plate plate={plate} marginTop={plate.kind === "full" && plate.ref !== "01 / 04" ? "38px" : undefined} />
          ))}
          <SeriesFooterNav
            nextRef={item.detail.next.ref}
            nextTitle={item.detail.next.title}
            nextHref={item.detail.next.href}
          />
        </>
      ) : (
        <>
          <SeriesTitleBlock title={item.title} standfirst={item.indexDescription} />
          <SeriesRecordBlock
            record={{
              place: item.place,
              dates: item.dateLabel,
              employer: item.employer,
              union: item.union,
              dispute: item.dispute,
              outcome: item.outcome,
              framesNote: `${item.frames}`,
              related: [],
            }}
            note="Plates for this series are still being catalogued and will be added shortly."
          />
          <SeriesFooterNav nextRef={nextItem.ref} nextTitle={nextItem.title} nextHref={`/series/${nextItem.slug}`} />
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .series-page {
    background: var(--paper);
  }
</style>
