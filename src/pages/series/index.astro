---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShellFrame from "../../components/ShellFrame.astro";
import TopBar from "../../components/TopBar.astro";
import DisplayHeading from "../../components/DisplayHeading.astro";
import IndexTable from "../../components/IndexTable.astro";
import IndexTableRow from "../../components/IndexTableRow.astro";
import PhotoRecord from "../../components/PhotoRecord.astro";
import { getCollection, getEntry } from "astro:content";

const series = (await getCollection("series")).sort((a, b) => a.data.ref.localeCompare(b.data.ref));
const seriesIndexFeaturedFrame = (await getEntry("frames", "series-index"))!.data;
---

<BaseLayout title="Photo sequences — Strategy of Refusal">
  <ShellFrame>
    <TopBar variant="shell" label="STRATEGY OF REFUSAL / PHOTO" labelHref="/" active="series" />

    <div class="intro">
      <DisplayHeading lines={["Photos"]} size={100} lineHeight=".88" />
      <p class="intro__para">Images as a form of inquiry</p>
    </div>

    <IndexTable>
      {series.map((item, i) => <IndexTableRow item={item} last={i === series.length - 1} />)}
    </IndexTable>

    <PhotoRecord
      image={seriesIndexFeaturedFrame.image}
      alt={seriesIndexFeaturedFrame.alt}
      height={seriesIndexFeaturedFrame.height}
      objectPosition={seriesIndexFeaturedFrame.objectPosition}
      plateRef={seriesIndexFeaturedFrame.ref}
      location={seriesIndexFeaturedFrame.location}
      date={seriesIndexFeaturedFrame.date}
      caption={seriesIndexFeaturedFrame.caption}
    />
  </ShellFrame>
</BaseLayout>

<style>
  .intro {
    padding: 40px var(--page-pad) 34px;
  }

  .intro__para {
    margin: 24px 0 0;
    max-width: 30em;
    font: 400 19px/1.45 Archivo, sans-serif;
    color: var(--cream);
  }

  @media (max-width: 700px) {
    .intro {
      padding: 24px 20px 24px;
    }
  }
</style>
